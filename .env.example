# OpenStatus — environment
#
# Copy to .env.local for development. Everything below is also set in Vercel.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser: never put a secret
# behind that prefix.

# ── Supabase — REQUIRED ────────────────────────────────────────────────────
# Without these the app does not boot: middleware throws, every API route 500s,
# and the public business pages go down with them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security — never expose it to the client.
# Also the fallback signing key for owner links and admin sessions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Where this deployment lives — REQUIRED in production ───────────────────
# Used for public page URLs, share-card images and OAuth redirect URIs. Leave
# it unset and those disagree with each other: links fall back to
# openstatus.co while OAuth redirects fall back to the Vercel preview host.
NEXT_PUBLIC_SITE_URL=https://openstatus.co

# ── Google Places — REQUIRED for a complete page ───────────────────────────
# Reads only, no OAuth. Powers setup's business search and the public page's
# photos, rating and reviews rows. Missing: search silently finds nothing and
# those rows fail to load.
#
# Note: review TEXT is on a pricier Places SKU than the star rating, so a key
# that returns "4.8" can still refuse the words. The Reviews block editor has
# a "Check what Google returns" button that reports which case you are in.
GOOGLE_PLACES_API_KEY=

# ── Google Business Profile OAuth — the actual product ─────────────────────
# Writing hours and same-day closures back to the business's Google listing.
# Missing: sync is off with an explicit message; nothing else breaks.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist. Defaults to the founders if unset.
ADMIN_EMAILS=

# Signs admin and owner-link sessions. Falls back to SUPABASE_SERVICE_ROLE_KEY.
# Set it properly so rotating the service key does not sign everyone out.
ADMIN_SESSION_SECRET=

# Optional second admin route. Ignored unless 16+ characters.
ADMIN_PASSCODE=

# ── Meta / Instagram — NOT WIRED UP ────────────────────────────────────────
# There is no Connect Instagram button and no job that syncs posts, so these
# do nothing today. Left here so the names are right if the feature is
# finished. See the functionality audit.
# NEXT_PUBLIC_META_APP_ID=
# META_APP_SECRET=

# ── Apple Sign In (optional) ──────────────────────────────────────────────────
# Set to 1 only AFTER Apple is enabled as a provider in Supabase
# (Authentication → Providers → Apple) with a real Apple Services ID and key.
# Left unset, the "Continue with Apple" button does not render at all, which is
# deliberate: a sign-in button that cannot sign anyone in is worse than one
# fewer option. Google and email work regardless.
NEXT_PUBLIC_APPLE_AUTH=
